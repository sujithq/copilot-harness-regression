{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "harness-repro-plugin-mcp": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/server/repro-mcp-server.mjs"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "REPRO_MCP_ORIGIN": "plugin"
      }
    }
  }
}
